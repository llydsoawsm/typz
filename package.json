{
  "name": "typz-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Modern, lightweight, type-safe backend framework inspired by Laravel's DX",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "routes": "node packages/cli/dist/index.js routes:list",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@typz/core": "workspace:*",
    "typz": "workspace:*"
  },
  "devDependencies": {
    "@libsql/client": "^0.14.0",
    "@libsql/core": "^0.18.0",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.5.8",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
